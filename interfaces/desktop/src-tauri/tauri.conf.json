{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SAM",
  "version": "0.1.0",
  "identifier": "dev.sam.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SAM",
        "width": 1180,
        "height": 760,
        "minWidth": 860,
        "minHeight": 580,
        "resizable": true,
        "visible": true,
        "center": true
      },
      {
        "label": "quick-assistant",
        "title": "SAM Quick Assistant",
        "width": 560,
        "height": 420,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "visible": false,
        "center": true,
        "skipTaskbar": true,
        "shadow": true
      }
    ],
    "trayIcon": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": true
    },
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "resources/sam-runtime": "sam-runtime"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Dhanush Surada",
    "copyright": "Copyright \u00a9 2026 Dhanush Surada",
    "category": "Productivity",
    "shortDescription": "SAM \u2014 a local, private AI assistant",
    "longDescription": "SAM is a fully local, privacy-first AI assistant that runs on your own computer with Ollama. No cloud, no API keys, no subscription."
  }
}
