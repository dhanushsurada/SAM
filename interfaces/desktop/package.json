{
  "name": "sam-desktop",
  "private": true,
  "version": "0.1.0",
  "description": "SAM desktop product UI (Phase 5) + native shell (Agent 1, src-tauri/). Not VEDA (frontend/), not the iQOO phone client (interfaces/web/).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "tauri": "tauri",
    "stage:runtime": "node scripts/stage-runtime.mjs",
    "package": "npm run stage:runtime && tauri build",
    "package:macos-consumer": "npm run package"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-notification": "^2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-icons": "^5.6.0",
    "react-router-dom": "^6.30.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/node": "^22.20.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.2",
    "vite": "^5.4.8"
  }
}
